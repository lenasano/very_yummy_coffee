      "updated": 1786956109519,
      "link": null,
      "locked": false,
      "text": "FmeRepostory filters incoming stream by\nuser key. FmeRepository also maintains\na cache of flag results for flags that\nshould not push updates mid-session.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FmeRepostory filters incoming stream by user key. FmeRepository also maintains a cache of flag results for flags that should not push updates mid-session.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
